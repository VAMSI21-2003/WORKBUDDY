# Uploads written at the repo root (e.g. by a run from the repo directory).
# Anchored so it doesn't touch workspace/uploads/.gitkeep below.
/uploads/

# WorkBuddy runtime data — keep the folders, ignore their contents
workspace/uploads/*
!workspace/uploads/.gitkeep
workspace/outputs/*
!workspace/outputs/.gitkeep
workspace/sessions/*
!workspace/sessions/.gitkeep
workspace/memory/*
!workspace/memory/.gitkeep

# Frontend (reserved for a future sprint)
frontend/node_modules/
frontend/dist/
frontend/build/

# Backend (reserved for a future sprint)
backend/__pycache__/

# Deployment: which release is live on this VM, and the backups (deploy/)
deploy/current.env
deploy/previous.env
deploy/.env
deploy/backups/
deploy/logs/
deploy/releases.log
deploy/docker-compose.override.yml

# Raw reviewer and probe output (docs/process/review-loop.md): summaries go in the review files
scripts/review_harness/**/out/
