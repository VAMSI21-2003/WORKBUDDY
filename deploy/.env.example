# Copy this file to .env on the VM (install.sh does it) and fill in the values there.
# .env is never committed and never printed; this file holds names only.
#     cp .env.example .env && chmod 600 .env

# The name people type, without https:// and without a slash. On Azure: <label>.<region>.cloudapp.azure.com
WORKBUDDY_DOMAIN=
# The Google sign-in client (docs/deploy.md, Section 7, step 6: how to create it).
WORKBUDDY_GOOGLE_CLIENT_ID=
WORKBUDDY_GOOGLE_CLIENT_SECRET=
# A long random token for scripts and for smoke.sh (they send it as "Authorization: Bearer ...").
# It reaches only the sessions it creates. Make one with:  openssl rand -hex 24
WORKBUDDY_OPERATOR_TOKEN=
# The LLM key (Groq): reads each request, and writes the replies when there is no Gemini key.
GROQ_API_KEY=
# The reply writer's key (Gemini, from https://aistudio.google.com/apikey). Optional: leave it empty
# and Groq writes the replies too.
GEMINI_API_KEY=

# Optional settings, with their defaults in docs/deploy.md, Section 2. Remove the # to set one.
# (WORKBUDDY_PUBLIC_ORIGIN and WORKBUDDY_TRUSTED_PROXY_HOPS are set by docker-compose.yml.)
# Only these Google accounts may sign in (comma-separated emails). Leave unset: any verified Google email.
# WORKBUDDY_ALLOWED_EMAILS=
# WORKBUDDY_MAX_CONCURRENT_TURNS=
# WORKBUDDY_TURN_DEADLINE_S=
# WORKBUDDY_MAX_UPLOAD_BYTES=
# WORKBUDDY_SESSION_TTL_HOURS=
# The Gemini model that writes the replies (default gemini-2.5-flash).
# GEMINI_MODEL=
# WORKBUDDY_DEMO_PASSWORD=   (not used any more: people sign in with Google. A value left from the
#   demo-password version is ignored. Keep that line while you might still roll back to that
#   version, which needs it; docs/deploy.md, Section 8.)
