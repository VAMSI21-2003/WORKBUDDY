# Copy this file to .env on the VM (install.sh does it) and fill in the values there.
# .env is never committed and never printed; this file holds names only.
#     cp .env.example .env && chmod 600 .env

# The name people type, without https:// and without a slash. On Azure: <label>.<region>.cloudapp.azure.com
WORKBUDDY_DOMAIN=
# The shared demo password people enter on the first page. Pick a long one.
WORKBUDDY_DEMO_PASSWORD=
# The LLM key (Groq).
GROQ_API_KEY=

# Optional settings, with their defaults in docs/deploy.md, Section 2. Remove the # to set one.
# (WORKBUDDY_PUBLIC_ORIGIN and WORKBUDDY_TRUSTED_PROXY_HOPS are set by docker-compose.yml.)
# WORKBUDDY_MAX_CONCURRENT_TURNS=
# WORKBUDDY_TURN_DEADLINE_S=
# WORKBUDDY_MAX_UPLOAD_BYTES=
# WORKBUDDY_SESSION_TTL_HOURS=
